# Prefer the Supabase transaction pooler for Next.js/serverless (port 6543).
# Direct connections (port 5432) can time out under load.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_POOL_SIZE=5
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-long-random-secret
FIELD_ENCRYPTION_KEY=replace-with-long-random-encryption-key
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=replace-with-project-id
APPWRITE_API_KEY=replace-with-api-key
APPWRITE_BUCKET_ID=replace-with-bucket-id
APPWRITE_STORAGE_PUBLIC=false

#
# ============================================
# EMAIL OTP SETUP
# ============================================
# Gmail account used to send password reset OTP emails
GMAIL_USER=yourgmailaddress@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password
GMAIL_FROM_EMAIL=yourgmailaddress@gmail.com
GMAIL_FROM_NAME=NCJ Support
